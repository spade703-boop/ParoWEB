#!name=MySekai 数据上报
#!desc=拦截游戏里的 MySekai 刷新响应，自动上报到 akitoya.top 生成资源地图与材料汇总卡
#!category=工具
#!homepage=__BASE_URL__/roomlist

[URL Rewrite]
^https:\/\/submit\.backtrace\.io\/ reject

[Script]
mysekai-capture = type=http-response, pattern=^https?://[^/]+\.dailygn\.com/api/user/\d+/mysekai(\?.*)?$, requires-body=1, binary-body-mode=1, max-size=104857600, script-path=__BASE_URL__/api/v1/mysekai/capture.js?t=__TOKEN__, timeout=60
mysekai-convert = type=http-response, pattern=^https?://[^/]+\.dailygn\.com/api/user/\d+/mysekai/convert/\d+/(start|receive|shorten)(\?.*)?$, requires-body=1, binary-body-mode=1, max-size=1048576, script-path=__BASE_URL__/api/v1/mysekai/convert.js?t=__TOKEN__, timeout=30

[MITM]
hostname = %APPEND% mkcn-prod-public-60001-1.dailygn.com, submit.backtrace.io
