PARO_ENV=development
PARO_DATABASE_PATH=data/paro_web.sqlite3
# 生产 docker-compose 的宿主机 Bot 数据目录（本地运行时无需设置）
PARO_BOT_DATA_DIR=/akito_bot/data
PARO_CONTENT_DIR=content
# 头像目录，不设置时退回 <PARO_CONTENT_DIR>/images
PARO_IMAGES_DIR=
PARO_ANNOUNCEMENTS_PATH=data/announcements.json
PARO_COOKIE_SECURE=false
PARO_ALLOWED_HOSTS=localhost,127.0.0.1
PARO_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PARO_DRAW_COOLDOWN_SECONDS=5
# 社区统计缓存秒数：全表聚合很贵（11 万行约 2.5 秒），0 关闭缓存
PARO_STATS_CACHE_SECONDS=60

# ---- MySekai 群友入口 ----
# 共享访问密码；留空则 /mysekai 功能关闭
PARO_MYSEKAI_PASSWORD=
# 会话 Cookie 的 HMAC 密钥；生产环境必须固定，否则重启后所有人重新登录
PARO_MYSEKAI_SESSION_SECRET=
# MySekai 出图服务（只在本机/内网访问）
PARO_MYSEKAI_SERVICE_URL=http://127.0.0.1:8765
# Haruki 工具箱公开 API / 资源 CDN / 主数据 CDN
PARO_MYSEKAI_HARUKI_BASE=https://toolbox-api-direct.haruki.seiunx.com
PARO_MYSEKAI_ASSET_BASE=https://sekai-assets.haruki.seiunx.com
PARO_MYSEKAI_MASTER_BASE=https://sekai-api-cdn.haruki.seiunx.com
# Bot 调用 /internal/v1/mysekai/* 的 Bearer 密钥；应与 Bot 的 MYSEKAI_PARO_TOKEN 一致
PARO_MYSEKAI_INTERNAL_TOKEN=
# 群推送 webhook；留空则只出图、不推送
PARO_MYSEKAI_PUSH_URL=http://host.docker.internal:8080/internal/v1/mysekai/push
# 应与 Bot 的 MYSEKAI_PUSH_TOKEN 一致；不要与上面的内部 API 密钥复用
PARO_MYSEKAI_PUSH_TOKEN=
# 移动端（iOS 抓包模块）上报密钥；留空则复用上面的 INTERNAL_TOKEN
PARO_MYSEKAI_INGEST_TOKEN=
# 只允许这些游戏 ID 上报（逗号分隔）；留空＝不限，但仍要求已绑定 QQ
PARO_MYSEKAI_INGEST_ALLOWLIST=
# Compose 构建解析服务的本地仓库目录；仓库需切到 feat/submit-json-profile
PARO_MYSEKAI_PIPELINE_DIR=../mysekai-re-pipeline
